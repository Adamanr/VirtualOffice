# Public domain (A record -> this server). Use "localhost" for a local run.
DOMAIN=office.example.com
ACME_EMAIL=admin@example.com

# Public IP of the server, advertised by LiveKit in ICE candidates.
# Local run: 127.0.0.1 (or your LAN IP to test from another device).
LIVEKIT_NODE_IP=203.0.113.10

# Generate: openssl rand -hex 16 / openssl rand -base64 32
LIVEKIT_API_KEY=APIchangeMe
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Leave empty to use wss://$DOMAIN/lk (proxied by Caddy). Set to e.g.
# wss://lk.example.com if LiveKit gets its own subdomain.
LIVEKIT_PUBLIC_URL=

# Generate: openssl rand -base64 48
SECRET_KEY_BASE=change-me-64-bytes-of-randomness-change-me-64-bytes-of-randomness

# Shared browser on office computers: HMAC secret shared by Phoenix and the
# browser service. Generate: openssl rand -hex 32
BROWSER_SECRET=change-me-browser-secret
# How many screens may run a browser at once (each is a Chromium tab, ~150-300 MB RAM).
BROWSER_MAX_SESSIONS=6
