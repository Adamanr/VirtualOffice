{
  "$comment": "Single source of truth for the space channel protocol. TS types are generated into shared/protocol.gen.ts (npm run gen:protocol in /client); the Phoenix server reads this file at compile time (Office.Protocol) to whitelist and validate client events. Field types are TypeScript type expressions; the server validates the subset: string, number, integer, boolean, T[] of primitives, string-literal unions and `| null`. A trailing `?` on a field name marks it optional.",
  "version": 1,
  "topic": "space:<spaceId>",
  "enums": {
    "Anim": {
      "idle": 0,
      "walk": 1,
      "run": 2,
      "sit": 3
    },
    "Emoji": {
      "thumbsUp": 1,
      "laugh": 2,
      "heart": 3,
      "clap": 4,
      "raiseHand": 5
    }
  },
  "types": {
    "PlayerTuple": "[x: number, y: number, z: number, rotY: number, anim: number]",
    "BatchEntry": "[id: string, x: number, y: number, z: number, rotY: number, anim: number]",
    "PresenceMeta": {
      "name": "string",
      "color": "string",
      "zone": "string | null",
      "muted": "boolean",
      "cam": "boolean",
      "look": "string",
      "online_at": "number"
    },
    "PdfState": {
      "url": "string",
      "name": "string",
      "page": "number",
      "pages": "number"
    },
    "ScreenState": {
      "id": "string",
      "owner": "string | null",
      "mode": "'share' | 'pdf' | 'browser' | null",
      "pdf": "PdfState | null",
      "url": "string | null"
    },
    "ChatMessage": {
      "id": "string",
      "from": "string",
      "name": "string",
      "scope": "'global' | 'zone'",
      "zone": "string | null",
      "text": "string",
      "ts": "number"
    },
    "PlayerSnapshot": {
      "id": "string",
      "s": "PlayerTuple"
    },
    "BoardStroke": {
      "id": "string",
      "boardId": "string",
      "from": "string",
      "points": "number[]",
      "color": "string",
      "width": "number"
    },
    "Sticker": {
      "id": "string",
      "boardId": "string",
      "url": "string",
      "x": "number",
      "y": "number",
      "rot": "number",
      "from": "string"
    },
    "PropState": {
      "id": "string",
      "jammed": "boolean",
      "lastItem": "string | null",
      "lastBuyer": "string | null"
    },
    "PropFx": {
      "id": "string",
      "propId": "string",
      "by": "string",
      "action": "string",
      "outcome": "string",
      "item": "string | null",
      "variant": "number",
      "t": "number"
    },
    "Toss": {
      "id": "string",
      "by": "string",
      "origin": "number[]",
      "vel": "number[]",
      "t": "number",
      "flight": "number",
      "land": "number[]",
      "hit": "'bin' | 'player' | null",
      "target": "string | null",
      "points": "number"
    },
    "Score": {
      "id": "string",
      "name": "string",
      "color": "string",
      "points": "number",
      "shots": "number",
      "bonks": "number",
      "drillMs": "number | null",
      "medals": "number"
    },
    "DrillEntry": {
      "id": "string",
      "name": "string",
      "ms": "number"
    },
    "DrillState": {
      "active": "boolean",
      "by": "string | null",
      "byName": "string | null",
      "startedAt": "number",
      "endsAt": "number",
      "cooldownUntil": "number",
      "evacuated": "DrillEntry[]"
    },
    "Jello": {
      "deskId": "string",
      "by": "string"
    },
    "PongState": {
      "id": "string",
      "a": "string | null",
      "b": "string | null",
      "pa": "number",
      "pb": "number",
      "ball": "number[]",
      "sa": "number",
      "sb": "number",
      "status": "'idle' | 'point' | 'playing' | 'won'",
      "winner": "string | null",
      "t": "number"
    },
    "Dart": {
      "id": "string",
      "boardId": "string",
      "by": "string",
      "u": "number",
      "v": "number",
      "points": "number",
      "ring": "string"
    },
    "Annotation": {
      "id": "string",
      "screenId": "string",
      "by": "string",
      "ctx": "string",
      "tool": "'pen' | 'highlight' | 'rect' | 'arrow'",
      "color": "string",
      "width": "number",
      "points": "number[]"
    },
    "AnnotSettings": {
      "screenId": "string",
      "locked": "boolean",
      "spotlight": "number[] | null",
      "ctx": "string"
    }
  },
  "join": {
    "params": {
      "playerId": "string",
      "name": "string",
      "color": "string",
      "look?": "string",
      "auth?": "string"
    },
    "reply": {
      "self": "string",
      "players": "PlayerSnapshot[]",
      "screens": "ScreenState[]",
      "chat": "ChatMessage[]",
      "boards": "BoardStroke[]",
      "stickers": "Sticker[]",
      "props": "PropState[]",
      "scores": "Score[]",
      "drill": "DrillState",
      "jellos": "Jello[]",
      "pongs": "PongState[]",
      "darts": "Dart[]",
      "annotations": "Annotation[]",
      "annotSettings": "AnnotSettings[]",
      "serverTime": "number"
    },
    "errors": [
      "bad_params",
      "full",
      "unauthorized"
    ]
  },
  "client": {
    "move": {
      "payload": {
        "s": "number[]"
      },
      "reply": null
    },
    "media_state": {
      "payload": {
        "muted": "boolean",
        "cam": "boolean"
      },
      "reply": null
    },
    "set_look": {
      "payload": {
        "look": "string"
      },
      "reply": null
    },
    "livekit_token": {
      "payload": {},
      "reply": {
        "token": "string",
        "url": "string | null",
        "room": "string"
      }
    },
    "screen_claim": {
      "payload": {
        "screenId": "string",
        "mode": "'share' | 'pdf' | 'browser'",
        "url?": "string"
      },
      "reply": {
        "screen": "ScreenState"
      }
    },
    "screen_release": {
      "payload": {
        "screenId": "string"
      },
      "reply": null
    },
    "pdf_open": {
      "payload": {
        "screenId": "string",
        "url": "string",
        "name": "string",
        "pages": "integer"
      },
      "reply": null
    },
    "pdf_page": {
      "payload": {
        "screenId": "string",
        "page": "integer"
      },
      "reply": null
    },
    "chat_send": {
      "payload": {
        "scope": "'global' | 'zone'",
        "text": "string"
      },
      "reply": null
    },
    "react": {
      "payload": {
        "emoji": "integer"
      },
      "reply": null
    },
    "board_stroke": {
      "payload": {
        "boardId": "string",
        "points": "number[]",
        "color": "string",
        "width": "number"
      },
      "reply": null
    },
    "board_clear": {
      "payload": {
        "boardId": "string"
      },
      "reply": null
    },
    "sticker_add": {
      "payload": {
        "boardId": "string",
        "url": "string",
        "x": "number",
        "y": "number",
        "rot": "number"
      },
      "reply": null
    },
    "sticker_remove": {
      "payload": {
        "boardId": "string",
        "stickerId": "string"
      },
      "reply": null
    },
    "sticker_move": {
      "payload": {
        "boardId": "string",
        "stickerId": "string",
        "x": "number",
        "y": "number"
      },
      "reply": null
    },
    "prop_use": {
      "payload": {
        "propId": "string",
        "action": "'buy' | 'kick' | 'use'",
        "item?": "string"
      },
      "reply": {
        "prop": "PropState | null"
      }
    },
    "toss": {
      "payload": {
        "origin": "number[]",
        "vel": "number[]"
      },
      "reply": null
    },
    "alarm_pull": {
      "payload": {
        "propId": "string"
      },
      "reply": null
    },
    "prank": {
      "payload": {
        "deskId": "string"
      },
      "reply": null
    },
    "browser_token": {
      "payload": {
        "screenId": "string"
      },
      "reply": {
        "token": "string",
        "control": "boolean"
      }
    },
    "pong_join": {
      "payload": {
        "tableId": "string"
      },
      "reply": {
        "side": "'a' | 'b'"
      }
    },
    "pong_leave": {
      "payload": {
        "tableId": "string"
      },
      "reply": null
    },
    "pong_paddle": {
      "payload": {
        "tableId": "string",
        "x": "number"
      },
      "reply": null
    },
    "dart_throw": {
      "payload": {
        "boardId": "string",
        "u": "number",
        "v": "number"
      },
      "reply": null
    },
    "darts_clear": {
      "payload": {
        "boardId": "string"
      },
      "reply": null
    },
    "note": {
      "payload": {
        "propId": "string",
        "midi": "integer"
      },
      "reply": null
    },
    "annot_stroke": {
      "payload": {
        "screenId": "string",
        "ctx": "string",
        "tool": "'pen' | 'highlight' | 'rect' | 'arrow'",
        "color": "string",
        "width": "number",
        "points": "number[]"
      },
      "reply": null
    },
    "annot_undo": {
      "payload": {
        "screenId": "string"
      },
      "reply": null
    },
    "annot_clear": {
      "payload": {
        "screenId": "string",
        "all": "boolean"
      },
      "reply": null
    },
    "annot_laser": {
      "payload": {
        "screenId": "string",
        "x": "number",
        "y": "number"
      },
      "reply": null
    },
    "annot_settings": {
      "payload": {
        "screenId": "string",
        "locked": "boolean",
        "spotlight": "number[] | null",
        "ctx": "string"
      },
      "reply": null
    }
  },
  "server": {
    "batch": {
      "t": "number",
      "p": "BatchEntry[]"
    },
    "correction": {
      "s": "PlayerTuple"
    },
    "screen_update": {
      "screen": "ScreenState"
    },
    "chat": {
      "msg": "ChatMessage"
    },
    "reaction": {
      "id": "string",
      "emoji": "number"
    },
    "board_stroke": {
      "stroke": "BoardStroke"
    },
    "board_clear": {
      "boardId": "string"
    },
    "sticker_update": {
      "boardId": "string",
      "stickers": "Sticker[]"
    },
    "prop_event": {
      "prop": "PropState | null",
      "fx": "PropFx"
    },
    "toss": {
      "toss": "Toss"
    },
    "scores": {
      "scores": "Score[]"
    },
    "drill": {
      "drill": "DrillState"
    },
    "desk_update": {
      "deskId": "string",
      "jello": "boolean",
      "by": "string | null"
    },
    "pong_state": {
      "pong": "PongState"
    },
    "dart": {
      "dart": "Dart",
      "from": "number[]"
    },
    "darts_clear": {
      "boardId": "string"
    },
    "note": {
      "id": "string",
      "propId": "string",
      "midi": "number"
    },
    "annot_stroke": {
      "stroke": "Annotation"
    },
    "annot_remove": {
      "screenId": "string",
      "ids": "string[]"
    },
    "annot_laser": {
      "screenId": "string",
      "id": "string",
      "x": "number",
      "y": "number"
    },
    "annot_settings": {
      "settings": "AnnotSettings"
    }
  },
  "errors": [
    "bad_payload",
    "unknown_event",
    "rate_limited",
    "busy",
    "not_owner",
    "too_far",
    "unknown_screen",
    "unknown_prop",
    "livekit_disabled",
    "cooldown",
    "locked"
  ]
}
