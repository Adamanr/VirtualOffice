{
  "$comment": "Single source of truth for the space channel protocol. TS types are generated into shared/protocol.gen.ts (npm run gen:protocol in /client); the Phoenix server reads this file at compile time (Office.Protocol) to whitelist and validate client events. Field types are TypeScript type expressions; the server validates the subset: string, number, integer, boolean, T[] of primitives, string-literal unions and `| null`. A trailing `?` on a field name marks it optional.",
  "version": 1,
  "topic": "space:<spaceId>",
  "enums": {
    "Anim": { "idle": 0, "walk": 1, "run": 2, "sit": 3 },
    "Emoji": { "thumbsUp": 1, "laugh": 2, "heart": 3, "clap": 4, "raiseHand": 5 }
  },
  "types": {
    "PlayerTuple": "[x: number, y: number, z: number, rotY: number, anim: number]",
    "BatchEntry": "[id: string, x: number, y: number, z: number, rotY: number, anim: number]",
    "PresenceMeta": {
      "name": "string",
      "color": "string",
      "zone": "string | null",
      "muted": "boolean",
      "cam": "boolean",
      "online_at": "number"
    },
    "PdfState": {
      "url": "string",
      "name": "string",
      "page": "number",
      "pages": "number"
    },
    "ScreenState": {
      "id": "string",
      "owner": "string | null",
      "mode": "'share' | 'pdf' | null",
      "pdf": "PdfState | null"
    },
    "ChatMessage": {
      "id": "string",
      "from": "string",
      "name": "string",
      "scope": "'global' | 'zone'",
      "zone": "string | null",
      "text": "string",
      "ts": "number"
    },
    "PlayerSnapshot": {
      "id": "string",
      "s": "PlayerTuple"
    }
  },
  "join": {
    "params": {
      "playerId": "string",
      "name": "string",
      "color": "string",
      "auth?": "string"
    },
    "reply": {
      "self": "string",
      "players": "PlayerSnapshot[]",
      "screens": "ScreenState[]",
      "chat": "ChatMessage[]",
      "serverTime": "number"
    },
    "errors": ["bad_params", "full", "unauthorized"]
  },
  "client": {
    "move": {
      "payload": { "s": "number[]" },
      "reply": null
    },
    "media_state": {
      "payload": { "muted": "boolean", "cam": "boolean" },
      "reply": null
    },
    "livekit_token": {
      "payload": {},
      "reply": { "token": "string", "url": "string | null", "room": "string" }
    },
    "screen_claim": {
      "payload": { "screenId": "string", "mode": "'share' | 'pdf'" },
      "reply": { "screen": "ScreenState" }
    },
    "screen_release": {
      "payload": { "screenId": "string" },
      "reply": null
    },
    "pdf_open": {
      "payload": { "screenId": "string", "url": "string", "name": "string", "pages": "integer" },
      "reply": null
    },
    "pdf_page": {
      "payload": { "screenId": "string", "page": "integer" },
      "reply": null
    },
    "chat_send": {
      "payload": { "scope": "'global' | 'zone'", "text": "string" },
      "reply": null
    },
    "react": {
      "payload": { "emoji": "integer" },
      "reply": null
    }
  },
  "server": {
    "batch": { "t": "number", "p": "BatchEntry[]" },
    "correction": { "s": "PlayerTuple" },
    "screen_update": { "screen": "ScreenState" },
    "chat": { "msg": "ChatMessage" },
    "reaction": { "id": "string", "emoji": "number" }
  },
  "errors": ["bad_payload", "unknown_event", "rate_limited", "busy", "not_owner", "too_far", "unknown_screen", "livekit_disabled"]
}
